# 复制为 .env 并按需修改（.env 已被 gitignore，不会提交到仓库）
# 所有配置项都可以用同名大写环境变量覆盖，例如 PORT=9000 python main.py

# 注意：只需要 Python 3.10+。requests 是可选的——没装会自动回退到 stdlib urllib，
# 只是少了连接池。所以裸解释器也能直接起。启动 banner 会打印当前用的是哪个。

# --- upstream ---
# 生成端点（原生协议，本代理负责 OpenAI <-> 原生 的转换）
base_url="https://api.commandcode.ai/alpha/generate"

# GET /v1/models 的数据源。留空时自动从 base_url 的域名推导：
#   https://api.commandcode.ai/provider/v1/models
# 这个官方端点返回权威模型列表（含 name / context_length / supported_endpoints），
# 不再需要仓库里硬编码一份模型清单。
models_url=""

# auth_token 是【最高优先级】的上游 key：填了就固定使用它，客户端自带的 key 也会被忽略。
# 留空时按下列顺序自动查找（找到即停）：
#   1. 环境变量 COMMANDCODE_API_KEY（也可写在本文件里）
#   2. 环境变量 COMMANDCODE_API_KEYS（逗号/换行分隔的多 key 池，轮询使用）
#   3. ~/.commandcode/auth.json
#   4. ~/.pi/agent/auth.json    （pi 兼容）
#   5. ~/.omp/agent/auth.json   （OMP 兼容）
# 全都没有时会自动走 OAuth 浏览器登录（见下方 auth_timeout）。
# auth.json 支持 {"apiKey": "..."} / {"commandcode": "..."} / {"command-code": {"type":"api","key":"..."}}
# 另外会透传客户端请求里以 user_ 开头的 key（x-api-key / Authorization: Bearer）。
# 只有 user_ 前缀的 key 会被透传——Claude Code、OpenAI SDK 这类客户端总会带一个占位
# token（如 "sk-none"），无脑转发会把本来可用的服务端 key 变成 401。
auth_token="your_command_code_token_here"

# 出站 HTTP(S) 代理。留空则直连，或回退到标准的 HTTP_PROXY / HTTPS_PROXY 环境变量。
# 国内直连 api.commandcode.ai 常见 SSL 握手失败，此时填本机代理即可。
#proxy="http://127.0.0.1:7890"
proxy=""

connect_timeout="15"
# 建连超时（秒）
read_timeout="600"
# 流式读取超时（秒），长回答需要放宽

# --- OAuth ---
# 找不到任何 key 时自动开浏览器登录，等待本地回调的毫秒数。
# 与 CLI 一致默认 15 秒；15 秒内没点完登录就会退回终端手动粘贴 key。
auth_timeout="15000"

# --- server ---
host="0.0.0.0"
port="3000"

# 代理层鉴权（可选）。填了之后客户端必须带 Authorization: Bearer <api_key>（或 x-api-key），
# 适合把服务暴露到内网/公网时使用。留空则不校验。
api_key=""

# DEBUG=true 时输出更详细的日志（每次尝试选用的 key 等内部细节）。
# 注意：即使不开启 DEBUG，服务也会把启动信息、每个请求、每次重试/流中断/上游错误/
# 客户端断开都打到 stderr——默认就不会静默。
debug=""

# --- model settings ---
# 客户端未指定模型时使用的默认模型
default_model="deepseek/deepseek-v4-flash"

# GET /v1/models 的过滤/排序白名单（逗号分隔，按此处顺序返回）。留空 = 返回上游全部模型。
# 用途：上游列出的是全量目录，其中部分模型不在当前套餐内（例如 Go 套餐调 gpt-5.4 会 403
# MODEL_NOT_IN_PLAN），把它筛掉可以避免客户端选到跑不通的模型。
models=""

# 上游模型列表的缓存秒数。设为 0 表示每次请求都回源。
models_ttl="300"

# --- native request envelope (optional) ---
# working_dir / environment 留空时使用【随机伪装值】（与 CLI 一致）：
# 每次启动生成一个随机工作目录（如 /Users/kqbmx/dev/wplt），并伪装 environment 为
# "linux-x64, Node.js v20.11.0"，同时发送 x-project-slug / x-taste-learning / x-co-flag 头，
# 避免暴露真实部署路径、形成固定指纹。
# 注意：一旦在这里填了值，就会覆盖伪装值。想保留伪装就别填这两项。
working_dir=""
environment=""

memory=""
taste=""
skills=""
permission_mode="standard"