# 复制为 .env 并按需修改（.env 已被 gitignore，不会提交到仓库）
# --- upstream ---
base_url="https://api.commandcode.ai/alpha/generate"
auth_token="your_command_code_token_here"

# --- server ---
host="0.0.0.0"
port="8090"

# --- model settings ---
# 客户端未指定模型时使用的默认模型
default_model="deepseek/deepseek-v4-flash"
# GET /v1/models 返回的模型目录（逗号分隔）
models="deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro,claude-sonnet-5,claude-fable-5,gpt-5.4,gpt-5.3-codex,moonshotai/Kimi-K3"

# --- native request envelope (optional) ---
# 以下为发送给 /alpha/generate 的请求外壳配置，留空使用默认值
working_dir="/tmp"
environment="terminal"
memory=""
taste=""
skills=""
permission_mode="standard"
